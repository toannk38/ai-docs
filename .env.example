# Sao chép thành .env và tự điền. KHÔNG commit .env.
# Tất cả giá trị dưới đây là của môi trường POC (tài khoản test, dữ liệu giả).

# Link AWS access portal (IAM Identity Center) của POC, vd https://<tên>.awsapps.com/start
QUICK_START_URL=
# Link đăng nhập thẳng Amazon Quick của POC, vd https://us-east-1.quicksight.aws.amazon.com/sn/account/<account>/start
QUICK_APP_URL=
# Quick account name của POC (tài liệu phát hành luôn hiển thị opba-ai)
QUICK_ACCOUNT_NAME=nab-quick-poc
# portal | direct
QUICK_LOGIN_METHOD=portal
AWS_REGION=us-east-1

# Tài khoản test (chỉ dữ liệu giả)
QUICK_USERNAME=
QUICK_PASSWORD=
# Secret Base32 của ứng dụng Authenticator (MFA TOTP)
QUICK_TOTP_SECRET=

# Trình duyệt
HEADLESS=true
SLOW_MO=150
VIEWPORT_WIDTH=1920
VIEWPORT_HEIGHT=1080
